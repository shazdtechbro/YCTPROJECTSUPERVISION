rules_version = '2';

// Role-based access control driven by custom claims (request.auth.token.role,
// request.auth.token.department). Claims are set server-side via the Admin SDK.
// There is NO client-side-only access control anywhere in this app — these
// rules are the enforcement boundary, together with storage.rules.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function role() {
      return request.auth.token.role;
    }
    function department() {
      return request.auth.token.department;
    }
    function isStudent() { return isSignedIn() && role() == 'student'; }
    function isSupervisor() { return isSignedIn() && role() == 'supervisor'; }
    function isHod() { return isSignedIn() && role() == 'hod'; }

    function existingProject(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }
    // Avoids a get() when the parent project doc is already being read/written.
    function isProjectStudent(project) {
      return isSignedIn() && (project.studentId == request.auth.uid
        || (project.keys().hasAny(['memberIds']) && project.memberIds.hasAny([request.auth.uid])));
    }
    function isProjectSupervisor(project) {
      return isSignedIn() && project.supervisorId == request.auth.uid;
    }
    function isProjectDepartmentHod(project) {
      return isHod() && project.department == department();
    }
    function canReadProject(project) {
      return isProjectStudent(project)
          || isProjectSupervisor(project)
          || isProjectDepartmentHod(project);
    }
    function canWriteProjectSubtree(project) {
      return isProjectStudent(project) || isProjectSupervisor(project);
    }

    // ---- users/{uid} ---------------------------------------------------
    match /users/{uid} {
      // A user reads their own doc. Supervisors read their assigned students.
      // HOD reads anyone in their department.
      allow get: if isSignedIn() && (
        request.auth.uid == uid
        || (isSupervisor() && resource.data.supervisorId == request.auth.uid)
        || (isHod() && resource.data.department == department())
      );
      allow list: if isSignedIn() && (
        (isSupervisor()
          && request.query.limit <= 50
          && resource.data.supervisorId == request.auth.uid)
        || (isHod()
          && request.query.limit <= 100
          && resource.data.department == department())
      );

      // Profile self-service only. Role / department / supervisorId are
      // provisioned by the Admin SDK and are immutable from the client.
      allow update: if request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'department', 'supervisorId', 'projectId', 'uid', 'matricNumber', 'email']);
      allow create, delete: if false; // Admin SDK only.

      // ---- users/{uid}/notifications/{id} ------------------------------
      // Written only by API routes (Admin SDK). The owner may read the feed
      // and flip `read` -> true; nothing else.
      match /notifications/{notificationId} {
        allow read: if request.auth.uid == uid;
        allow update: if request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    // ---- dashboard_stats/{supervisorId} ------------------------------
    // Denormalised counters. Read by the owning supervisor and by the HOD of
    // the same department. Written ONLY by Cloud Functions (Admin SDK).
    match /dashboard_stats/{supervisorId} {
      allow get: if isSignedIn() && (
        request.auth.uid == supervisorId
        || (isHod() && resource.data.department == department())
      );
      allow list: if isHod()
        && request.query.limit <= 100
        && resource.data.department == department();
      allow write: if false;
    }

    // ---- activity_daily/{id} ---------------------------------------
    // Per-department daily activity buckets for the HOD analytics chart.
    // Admin SDK writes only.
    match /activity_daily/{docId} {
      allow read: if isHod() && resource.data.department == department();
      allow list: if isHod()
        && request.query.limit <= 120
        && resource.data.department == department();
      allow write: if false;
    }

    // ---- projects/{projectId} ---------------------------------------
    match /projects/{projectId} {
      allow get: if canReadProject(resource.data);
      allow list: if isSignedIn() && (
        (isSupervisor() && resource.data.supervisorId == request.auth.uid)
        || (isHod() && resource.data.department == department())
        || (isStudent() && isProjectStudent(resource.data))
      );

      // Mutations are authorised and audited by the server API only.
      allow create, update, delete: if false;

      // ---- projects/{projectId}/tickets/{ticketId} ----------------
      match /tickets/{ticketId} {
        function project() { return existingProject(projectId); }
        allow read: if canReadProject(project());
        allow create: if canWriteProjectSubtree(project())
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.projectId == projectId;
        allow update: if canWriteProjectSubtree(project());
        allow delete: if isProjectSupervisor(project());
      }

      // Audit log is written only by trusted server routes and readable by
      // project members, the assigned supervisor and the department HOD.
      match /activity/{activityId} {
        function project() { return existingProject(projectId); }
        allow read: if canReadProject(project());
        allow write: if false;
      }

      // ---- projects/{projectId}/submissions/{submissionId} --------
      match /submissions/{submissionId} {
        function project() { return existingProject(projectId); }
        allow read: if canReadProject(project());
        allow create, update, delete: if false;

        // ---- .../comments/{commentId} --------------------------
        match /comments/{commentId} {
          function project() { return existingProject(projectId); }
          allow read: if canReadProject(project());
          allow create: if canWriteProjectSubtree(project())
            && request.resource.data.authorId == request.auth.uid;
          // Comments are immutable once posted; author may delete their own.
          allow update: if false;
          allow delete: if isSignedIn()
            && resource.data.authorId == request.auth.uid;
        }
      }
    }

    // Deny everything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
