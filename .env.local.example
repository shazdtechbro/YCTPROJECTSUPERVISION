# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
# On Vercel, set these in Project Settings -> Environment Variables for BOTH
# the Preview and Production environments.
#
# Firebase = Auth + Firestore.  Supabase = file Storage (project is on the
# Firebase Spark plan; Firebase Storage requires Blaze).
# ---------------------------------------------------------------------------

# --- Firebase client SDK (PUBLIC) ---------------------------------------
# Safe to expose in the browser bundle. These identify the project; they are
# NOT secrets. Access is controlled by Firestore Security Rules + verified
# custom claims, not by hiding these values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (SERVER-ONLY, SECRET) --------------------------
# The FULL service-account JSON, on one line. NEVER prefix with NEXT_PUBLIC.
# Used by route handlers / server actions for session-cookie verification and
# custom-claims management. Firebase console -> Project settings ->
# Service accounts -> "Generate new private key".
FIREBASE_SERVICE_ACCOUNT_KEY=

# Optional private password required by scripts/seed.mjs for demo accounts.
# Never use a shared/public demo password on a live deployment.
YCT_DEMO_PASSWORD=

# --- Supabase Storage (client, PUBLIC) --------------------------------
# Project URL + anon key. The anon key is protected by Storage RLS policies,
# not by being hidden. Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase Storage (SERVER-ONLY, SECRET) --------------------------
# service_role key — bypasses RLS. NEVER prefix with NEXT_PUBLIC. Used only in
# route handlers to mint short-lived signed download URLs after the caller has
# been verified. Supabase dashboard -> Project Settings -> API.
SUPABASE_SERVICE_ROLE_KEY=
